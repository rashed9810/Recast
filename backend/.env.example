# Recast backend settings.
#
# The easiest way to connect a model is the "Model setup" dialog in the app
# (click the model badge, top right). Settings saved there go to data/model.json
# and take priority over the LLM_* values below. Delete data/model.json to
# fall back to this file.

LLM_PROVIDER=demo                 # demo | openai | anthropic
# "openai" means ANY OpenAI-compatible server: Ollama, LM Studio, Groq,
# Google Gemini, OpenRouter, OpenAI, vLLM ...

# Example: Ollama on this computer (free, private, no limits)
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b-instruct

# Example: a cloud service
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-key
# LLM_MODEL=model-id-from-the-service

LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=300           # per paragraph; raise for slow computers
LLM_CONCURRENCY=2                 # use 1 for a model on your own computer

MAX_INPUT_CHARS=60000
MAX_SEGMENT_WORDS=300
CORS_ORIGINS=http://localhost:3000
# RECAST_DATA_DIR=./data          # where saved model settings live
